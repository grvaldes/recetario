# ==============================================================================
# Recetario Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env

# General Application Settings
APP_NAME=Recetario
VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Frontend Web Server Host Port
PORT=3041

# PostgreSQL Database Configuration
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=recetario
POSTGRES_USER=recetario
POSTGRES_PASSWORD=recetario_secret_change_in_production

# Optional direct database connection string (if provided, overrides individual POSTGRES_* settings)
# DATABASE_URL=postgresql+psycopg://recetario:recetario_secret@db:5432/recetario

# Persistent Storage for Recipe Media and Uploads
UPLOAD_DIR=/app/uploads

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3041,http://127.0.0.1:3041,http://localhost:5173
